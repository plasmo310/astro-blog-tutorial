---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const pageTitle = "About me";

const identity = {
    name: "plasmo",
    jobs: [
        "Game Developer",
        "Software Engineer",
    ],
};

const favorites = [
    "Unity",
    "Unreal Engine",
    "Houdini"
];

const showPrivate: boolean = true;
const showSelect: number = 0;
const isFinished: boolean = true;

const styleSkillColor = "crimson";
const styleFontWeight = "bold";
const styleTextCase = "uppercase"
---

<BaseLayout pageTitle={pageTitle}>
    <style define:vars={{styleSkillColor, styleFontWeight, styleTextCase}}>
        .favorite {
            color: var(--styleSkillColor);
            font-weight: var(--styleFontWeight);
            text-transform: var(--styleTextCase)
        }
    </style>
    <p>I am Game {identity.jobs.join(" and ")}!!</p>
    <p>■Favorites</p>        
    <ul>
        {favorites.map((favorite) => <li class="favorite">{favorite}</li>)}
    </ul>
    {
        showPrivate && <p>I'm not good at getting up early...</p>
    }
    {
        showSelect === 2 ? <p>Cat is very cute.</p> : <></>
    }
    {
        isFinished && <p>Finished Astro.js tutorial!!</p>
    }
</BaseLayout>
