---
import '../styles/global.css';

const pageTitle = "About me";

const identity = {
    name: "plasmo",
    jobs: [
        "Game Developer",
        "Software Engineer",
    ],
};

const favorites = [
    "Unity",
    "Unreal Engine",
    "Houdini"
];

const showPrivate: boolean = true;
const showSelect: number = 0;

const styleSkillColor = "crimson";
const styleFontWeight = "bold";
const styleTextCase = "uppercase"
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
        <style define:vars={{styleSkillColor, styleFontWeight, styleTextCase}}>
            h1 {
                color: purple;
                font-size: 4rem;
            }
            .favorite {
                color: var(--styleSkillColor);
                font-weight: var(--styleFontWeight);
                text-transform: var(--styleTextCase)
            }
        </style>
	</head>
	<body>
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/blog/">Blog</a>

		<h1>{pageTitle}</h1>
        <p>I am Game {identity.jobs.join(" and ")}!!</p>
        <p>■Favorites</p>        
        <ul>
            {favorites.map((favorite) => <li class="favorite">{favorite}</li>)}
        </ul>
        {
            showPrivate && <p>I'm not good at getting up early...</p>
        }
        {
            showSelect === 2 ? <p>Cat is very cute.</p> : <></>
        }
	</body>
</html>
